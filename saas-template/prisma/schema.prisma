// ================================================================
// SCHEMA.PRISMA — Base genérica multi-tenant
//
// Tenant + User son la base que TODO SaaS de esta plataforma necesita.
// Material es un módulo CRUD de EJEMPLO — bórralo y reemplázalo por las
// entidades de tu dominio (ver el marcador al final del archivo).
// ================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MEMBER
}

model Tenant {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessName String
  logoUrl      String?

  users     User[]
  materials Material[]

  @@map("tenants")
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Id del usuario en Supabase Auth (auth.users.id). Este es el enlace
  /// entre la identidad gestionada por Supabase y nuestra tabla de negocio.
  /// NO guardamos contraseñas: de eso se encarga Supabase Auth.
  authUserId String @unique

  email  String
  name   String
  role   UserRole @default(MEMBER)
  active Boolean  @default(true)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ----------------------------------------------------------------
// EJEMPLO: módulo CRUD de catálogo. Sirve como referencia viva del
// patrón (ver .claude/skills/nuevo-modulo-crud/SKILL.md). Bórralo
// cuando tengas tus propias entidades.
// ----------------------------------------------------------------

enum MeasurementUnit {
  UNIT
  M2
  LINEAR_METER
  HOUR
}

model Material {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name     String
  unit     MeasurementUnit
  baseCost Decimal         @db.Decimal(12, 4)
  active   Boolean         @default(true)

  @@index([tenantId])
  @@map("materials")
}

// ================================================================
// AGREGA AQUÍ LAS ENTIDADES DE TU DOMINIO DE NEGOCIO
//
// Reglas no negociables (ver docs/arquitectura-estandar.md):
// - Toda tabla de negocio lleva `tenantId String` + `@@index([tenantId])`.
// - Si una entidad puede estar referenciada por transacciones históricas,
//   agrega `active Boolean @default(true)` para soft-delete.
// - Si el precio/costo de un catálogo puede cambiar, la tabla que lo
//   referencia debe guardar un snapshot del valor, no solo el id.
// - Después de cambiar este archivo, actualiza prisma/policies/rls.sql
//   con las políticas RLS de las tablas nuevas.
// ================================================================
