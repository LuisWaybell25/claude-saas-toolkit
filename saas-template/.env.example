# Copiar a .env.local y llenar con los valores del proyecto de Supabase.

# Prisma → Postgres. Settings → Database → Connection string.
# Usa la versión "Session"/directa para migraciones y la "Transaction"
# (puerto 6543) para runtime si activas el connection pooler.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Supabase Auth. Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Solo para scripts de servidor / admin. NUNCA la expongas en el cliente
# ni la prefijes con NEXT_PUBLIC_: ignora las políticas de RLS.
SUPABASE_SERVICE_ROLE_KEY=""

# Opcional: id de un tenant existente, para `npx prisma db seed`.
SEED_TENANT_ID=""
